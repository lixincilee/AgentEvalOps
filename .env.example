# 复制为 .env 并填入真实值；.env 已被 .gitignore 忽略，不会进入版本库。
DEEPSEEK_API_KEY=

# 以下均为可选覆盖项（默认值见 README「阶段二」一节）
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# AGENTEVALOPS_TEMPERATURE=0
# AGENTEVALOPS_MAX_TOKENS=1024
# AGENTEVALOPS_REQUEST_TIMEOUT_S=60
# AGENTEVALOPS_MAX_RETRIES=2
# AGENTEVALOPS_BUDGET_USD=1.0   # 示例值：单次运行最多花 1 美元；不设置则不限
# AGENTEVALOPS_PRICING_JSON={"deepseek-flash": {"input_per_1m_usd": 0.1, "output_per_1m_usd": 0.4}}   # 必须写成单行 JSON；用来给本端点独有的模型 id 定价
