# 复制为 .env 并填入真实值；.env 已被 .gitignore 忽略，不会进入版本库。
DEEPSEEK_API_KEY=

# 以下均为可选覆盖项（默认值见 README「阶段二」一节）
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# AGENTEVALOPS_TEMPERATURE=0
# AGENTEVALOPS_MAX_TOKENS=1024
# AGENTEVALOPS_REQUEST_TIMEOUT_S=60
# AGENTEVALOPS_MAX_RETRIES=2
# AGENTEVALOPS_BUDGET=1.0        # 可选：单次运行花费上限，单位与价目表货币一致（默认人民币元）；设置后未定价模型会直接报错
# AGENTEVALOPS_CURRENCY=CNY      # 可选：价目表货币，默认 CNY
# AGENTEVALOPS_PRICING_JSON={"some-other-model": {"input_per_1m": 1.0, "output_per_1m": 2.0}}   # 可选：deepseek-flash / deepseek-v4-pro 已内置真实价目
