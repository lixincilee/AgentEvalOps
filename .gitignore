__pycache__/
.env
runs/
# 评测报告是运行产物：每次跑都会重新生成（内容含时间戳），入库必然弄脏工作区，
# 使下一次运行的 VersionManifest 变成 -dirty、is_reproducible=false。
# 结论与数字汇总在 docs/ 下，原始报告交给 CI 当工件上传。
reports/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.venv/
.venv-judge/
venv/
# M9：本地固定版本的 promptfoo（npm install --no-save --prefix .promptfoo）。
# 它是一份可重装的工具，不是源码；固定版本号写在 scripts/judge_l5_promptfoo.py。
.promptfoo/
dist/
build/
.idea/
.vscode/

# 门禁用的临时候选目录：它是一次检查的中间产物，不是要归档的发布。
# 用 .release-candidate* 而不是 .release-candidate/：注入回归演示会写
# .release-candidate-regression/，漏一个通配就会在 git status 里留噪声。
.release-candidate*/

# 补冻历史版本用的 worktree（冻结器本身不在旧 tag 上，得借过去一份）。
# 它是工具，不是产物；harness 那一份提交在 freeze/<tag> 分支上。
.worktrees/
